/* Audited bytecode-actor primitive policy.
 *
 * Each entry supplies name, function, arity, capability, family, and audit.
 *
 * This is the single reviewed source used by both the runtime fence and
 * ocamlactorcheck. Unknown names and arities are forbidden.
 */

ACTOR_PRIMITIVE(
  "caml_int_compare", caml_int_compare, 2, PURE, integer,
  "Compares two tagged integers without allocation or mutation.")
ACTOR_PRIMITIVE(
  "caml_actor_spawn", caml_actor_spawn, 1, SCHEDULER_AWARE, actor,
  "Copies a closure into a private heap through the scheduler.")
ACTOR_PRIMITIVE(
  "caml_actor_self", caml_actor_self, 1, SCHEDULER_AWARE, actor,
  "Returns the scheduler-owned identity of the current actor.")
ACTOR_PRIMITIVE(
  "caml_actor_yield", caml_actor_yield, 1, SCHEDULER_AWARE, actor,
  "Requests a scheduler yield after the primitive returns.")
ACTOR_PRIMITIVE(
  "caml_actor_send", caml_actor_send, 2, SCHEDULER_AWARE, actor,
  "Commits a pointer-free mailbox message through the scheduler.")
ACTOR_PRIMITIVE(
  "caml_actor_receive", caml_actor_receive, 1, SCHEDULER_AWARE, actor,
  "Receives through the scheduler-owned mailbox boundary.")
ACTOR_PRIMITIVE(
  "caml_actor_stats", caml_actor_stats, 1, SCHEDULER_AWARE, actor,
  "Copies deterministic scheduler counters into the actor heap.")
ACTOR_PRIMITIVE(
  "caml_array_make", caml_array_make, 2, ACTOR_LOCAL, array,
  "Allocates and initializes a new actor-owned array.")
ACTOR_PRIMITIVE(
  "caml_array_get_addr", caml_array_get_addr, 2, ACTOR_LOCAL, array,
  "Reads a checked field from an actor-owned value array.")
ACTOR_PRIMITIVE(
  "caml_array_set_addr", caml_array_set_addr, 3, ACTOR_LOCAL, array,
  "Writes a checked field in an actor-owned value array.")
ACTOR_PRIMITIVE(
  "caml_array_unsafe_get", caml_array_unsafe_get, 2, ACTOR_LOCAL, array,
  "Reads an actor-owned value array with actor-mode bounds checks.")
ACTOR_PRIMITIVE(
  "caml_array_unsafe_set", caml_array_unsafe_set, 3, ACTOR_LOCAL, array,
  "Writes an actor-owned value array with actor-mode ownership checks.")
ACTOR_PRIMITIVE(
  "caml_array_blit", caml_array_blit, 5, ACTOR_LOCAL, array,
  "Copies between actor-owned arrays after validating the whole range.")
ACTOR_PRIMITIVE(
  "caml_array_fill", caml_array_fill, 4, ACTOR_LOCAL, array,
  "Fills an actor-owned array after validating the value and range.")
ACTOR_PRIMITIVE(
  "caml_sys_get_config", CAML_ACTOR_NO_PRIMITIVE, 1, FORBIDDEN, system,
  "Reads process-global configuration outside actor ownership.")
